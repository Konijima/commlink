# commlink server configuration.
#
# Copy this file to `.env` (git-ignored) and the server loads it from the working
# directory on start. A real environment variable still wins, so your service manager
# or a one-off `PORT=… pnpm start` overrides a value set here. Comments go on their own
# line; a value may be quoted to keep surrounding spaces or a `#`.

# Port to listen on.
PORT=4500

# Interface to bind. Loopback by default; expose via a TLS reverse proxy.
HOST=127.0.0.1

# Path to the SQLite database file (created on first run). It holds both the cached
# messages and the auth tokens, so `token:create` must be pointed at the same file.
DB_PATH=./commlink.sqlite

# How long to retain cached messages, in hours. A whole number, at least 1.
RETENTION_HOURS=72

# Log verbosity: trace, debug, info, warn, error, fatal, or silent to turn logging off.
# Logs are structured JSON on stdout; a subscribe token in a `?auth=` URL is redacted.
LOG_LEVEL=info
