# commlink server configuration.
#
# The server does not load a .env file yet; it reads these from the process
# environment. Export them in your shell or set them in your service manager.
# A .env file (git-ignored) will be loaded once that lands — see TODO.md.

# Port to listen on.
PORT=4500

# Interface to bind. Loopback by default; expose via a TLS reverse proxy.
HOST=127.0.0.1

# Path to the SQLite database file (created on first run).
DB_PATH=./commlink.sqlite

# --- Not read yet; this arrives with message retention. ---

# How long to retain cached messages, in hours.
RETENTION_HOURS=72
