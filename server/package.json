{
  "name": "@commlink/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "commlink pub/sub push-notification server.",
  "license": "MIT",
  "author": "Konijima",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "token:create": "tsx src/cli/token-create.ts",
    "token:list": "tsx src/cli/token-list.ts",
    "token:revoke": "tsx src/cli/token-revoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "ws": "^8.21.0"
  }
}
